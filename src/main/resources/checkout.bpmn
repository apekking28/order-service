<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:drools="http://www.jboss.org/drools"
                   id="definition-checkout"
                   targetNamespace="http://www.jboss.org/drools">

  <!-- Item Definitions -->
  <bpmn2:itemDefinition id="_orderIdItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_customerNameItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_itemItem" structureRef="String"/>
  <bpmn2:itemDefinition id="_quantityItem" structureRef="Integer"/>
  <bpmn2:itemDefinition id="_amountItem" structureRef="Double"/>
  <bpmn2:itemDefinition id="_trackingNumberItem" structureRef="String"/>

  <!-- Interface Declaration -->
  <bpmn2:interface id="CheckoutServiceInterface" name="org.apekking.service.CheckoutService" implementationRef="org.apekking.service.CheckoutService">
    <bpmn2:operation id="reserveStockOp" name="reserveStock" implementationRef="reserveStock"/>
    <bpmn2:operation id="processPaymentOp" name="processPayment" implementationRef="processPayment"/>
    <bpmn2:operation id="createDeliveryOrderOp" name="createDeliveryOrder" implementationRef="createDeliveryOrder"/>
  </bpmn2:interface>

  <bpmn2:process id="checkout" name="Marketplace Checkout Process" isExecutable="true">

    <!-- Process Variables -->
    <bpmn2:property id="orderId" itemSubjectRef="_orderIdItem"/>
    <bpmn2:property id="customerName" itemSubjectRef="_customerNameItem"/>
    <bpmn2:property id="item" itemSubjectRef="_itemItem"/>
    <bpmn2:property id="quantity" itemSubjectRef="_quantityItem"/>
    <bpmn2:property id="amount" itemSubjectRef="_amountItem"/>
    <bpmn2:property id="trackingNumber" itemSubjectRef="_trackingNumberItem"/>

    <!-- 1. Start Event -->
    <bpmn2:startEvent id="startEvent" name="Start Checkout">
      <bpmn2:outgoing>flow1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:sequenceFlow id="flow1" sourceRef="startEvent" targetRef="reserveStockTask"/>

    <!-- 2. Service Task: Reserve Stock -->
    <bpmn2:serviceTask id="reserveStockTask" name="Reserve Stock" operationRef="reserveStockOp" implementation="Java">
      <bpmn2:incoming>flow1</bpmn2:incoming>
      <bpmn2:outgoing>flow2</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="reserve_orderId" name="Parameter-1"/>
        <bpmn2:dataInput id="reserve_item" name="Parameter-2"/>
        <bpmn2:dataInput id="reserve_quantity" name="Parameter-3"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>reserve_orderId</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>reserve_item</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>reserve_quantity</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>orderId</bpmn2:sourceRef>
        <bpmn2:targetRef>reserve_orderId</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>item</bpmn2:sourceRef>
        <bpmn2:targetRef>reserve_item</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>quantity</bpmn2:sourceRef>
        <bpmn2:targetRef>reserve_quantity</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>

    <bpmn2:sequenceFlow id="flow2" sourceRef="reserveStockTask" targetRef="processPaymentTask"/>

    <!-- 3. Service Task: Process Payment -->
    <bpmn2:serviceTask id="processPaymentTask" name="Process Payment" operationRef="processPaymentOp" implementation="Java">
      <bpmn2:incoming>flow2</bpmn2:incoming>
      <bpmn2:outgoing>flow3</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="payment_orderId" name="Parameter-1"/>
        <bpmn2:dataInput id="payment_amount" name="Parameter-2"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>payment_orderId</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>payment_amount</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet/>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>orderId</bpmn2:sourceRef>
        <bpmn2:targetRef>payment_orderId</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>amount</bpmn2:sourceRef>
        <bpmn2:targetRef>payment_amount</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:serviceTask>

    <bpmn2:sequenceFlow id="flow3" sourceRef="processPaymentTask" targetRef="createDeliveryTask"/>

    <!-- 4. Service Task: Create Delivery Order (Updated 5 Parameters) -->
    <bpmn2:serviceTask id="createDeliveryTask" name="Create Delivery Order" operationRef="createDeliveryOrderOp" implementation="Java">
      <bpmn2:incoming>flow3</bpmn2:incoming>
      <bpmn2:outgoing>flow4</bpmn2:outgoing>
      <bpmn2:ioSpecification>
        <bpmn2:dataInput id="delivery_orderId" name="Parameter-1"/>
        <bpmn2:dataInput id="delivery_customerName" name="Parameter-2"/>
        <bpmn2:dataInput id="delivery_item" name="Parameter-3"/>
        <bpmn2:dataInput id="delivery_quantity" name="Parameter-4"/>
        <bpmn2:dataInput id="delivery_amount" name="Parameter-5"/>
        <bpmn2:dataOutput id="delivery_trackingNumber" name="Result"/>
        <bpmn2:inputSet>
          <bpmn2:dataInputRefs>delivery_orderId</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>delivery_customerName</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>delivery_item</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>delivery_quantity</bpmn2:dataInputRefs>
          <bpmn2:dataInputRefs>delivery_amount</bpmn2:dataInputRefs>
        </bpmn2:inputSet>
        <bpmn2:outputSet>
          <bpmn2:dataOutputRefs>delivery_trackingNumber</bpmn2:dataOutputRefs>
        </bpmn2:outputSet>
      </bpmn2:ioSpecification>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>orderId</bpmn2:sourceRef>
        <bpmn2:targetRef>delivery_orderId</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>customerName</bpmn2:sourceRef>
        <bpmn2:targetRef>delivery_customerName</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>item</bpmn2:sourceRef>
        <bpmn2:targetRef>delivery_item</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>quantity</bpmn2:sourceRef>
        <bpmn2:targetRef>delivery_quantity</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataInputAssociation>
        <bpmn2:sourceRef>amount</bpmn2:sourceRef>
        <bpmn2:targetRef>delivery_amount</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation>
        <bpmn2:sourceRef>delivery_trackingNumber</bpmn2:sourceRef>
        <bpmn2:targetRef>trackingNumber</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:serviceTask>

    <bpmn2:sequenceFlow id="flow4" sourceRef="createDeliveryTask" targetRef="endEvent"/>

    <!-- 5. End Event -->
    <bpmn2:endEvent id="endEvent" name="Order Completed">
      <bpmn2:incoming>flow4</bpmn2:incoming>
    </bpmn2:endEvent>

  </bpmn2:process>

  <!-- BPMN Diagram Layout Coordinates -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_checkout">
    <bpmndi:BPMNPlane id="BPMNPlane_checkout" bpmnElement="checkout">
      <bpmndi:BPMNShape id="shape_startEvent" bpmnElement="startEvent">
        <dc:Bounds x="100" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reserveStockTask" bpmnElement="reserveStockTask">
        <dc:Bounds x="190" y="80" width="130" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_processPaymentTask" bpmnElement="processPaymentTask">
        <dc:Bounds x="360" y="80" width="130" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_createDeliveryTask" bpmnElement="createDeliveryTask">
        <dc:Bounds x="530" y="80" width="150" height="76"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_endEvent" bpmnElement="endEvent">
        <dc:Bounds x="720" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      
      <bpmndi:BPMNEdge id="edge_flow1" bpmnElement="flow1">
        <di:waypoint x="136" y="118"/>
        <di:waypoint x="190" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow2" bpmnElement="flow2">
        <di:waypoint x="320" y="118"/>
        <di:waypoint x="360" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow3" bpmnElement="flow3">
        <di:waypoint x="490" y="118"/>
        <di:waypoint x="530" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow4" bpmnElement="flow4">
        <di:waypoint x="680" y="118"/>
        <di:waypoint x="720" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>